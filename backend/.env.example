# Configuración de variables de entorno para SendGrid
# Reemplace con su clave API real generada en https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Correo remitente verificado en SendGrid (Single Sender Verification o Domain Authentication)
SENDGRID_FROM_EMAIL=notificaciones@tudominio.com
